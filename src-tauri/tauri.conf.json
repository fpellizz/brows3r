{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "brows3r",
  "version": "1.20.0",
  "identifier": "com.brows3r.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "brows3r",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis"],
    "shortDescription": "Cross-platform S3-compatible object storage browser",
    "longDescription": "brows3r is a desktop client for S3-compatible object storage (AWS S3, MinIO, Backblaze B2, Cloudflare R2, Wasabi, Google Cloud Storage, OCI, ...). It provides bucket browsing, multipart uploads/downloads, drag and drop, object versioning, lifecycle and CORS management, batch operations, an integrated S3 terminal, a usage dashboard, and an embedded preview pane for images, text, audio and video.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libglib2.0-0",
          "libsoup-3.0-0",
          "libjavascriptcoregtk-4.1-0",
          "librsvg2-2",
          "xdg-utils",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "glib2",
          "libsoup3",
          "javascriptcoregtk4.1",
          "librsvg2",
          "xdg-utils",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "wix": {},
      "nsis": {}
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/fpellizz/brows3r/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGNTVFMDEwRjdGMjZDQTcKUldTbmJQTDNFT0JWdjJkaWJBMG9VdGlaN2hMb25rMDhBb1hYNTBZNHFOQlFiOHlrWG9LTFNNVE8K"
    }
  }
}
